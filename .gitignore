# ==============================================================================
# AQUALYTICA - MASTER .GITIGNORE
# Safe exclusions: blocks sensitive credentials, secrets, build artifacts,
# machine learning checkpoints, caches, temporary testing directories & OS junk.
# Does NOT block project source code, models, configs, or documentation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Private Credentials, Secrets & Sensitive Files
# ------------------------------------------------------------------------------
PROJECT_CREDENTIALS_PRIVATE.txt
*credentials_private*
*credentials-private*
*CREDENTIALS_PRIVATE*
*credential*
*Credential*
*CREDENTIAL*
*secret*.txt
*private*.txt
secrets.txt
passwords.txt
*password*
*Password*
*PASSWORD*
*auth_token*
*bearer_token*
*api_key*
*apiKey*
*API_KEY*

# Environment Variable Files
.env
.env.*
*.env
*.env.*
# Allow sample / template environment files if created
!.env.example
!*.env.example
!.env.template
!*.env.template

# Cryptographic Keys, Certificates & Keystores
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.der
*service-account*.json
google-services.json

# ------------------------------------------------------------------------------
# 2. Operating System Generated Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
