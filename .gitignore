# ==============================================================================
# AQUALYTICA - MASTER .GITIGNORE
# Safe exclusions: blocks sensitive credentials, build artifacts, caches & OS junk
# Does NOT block any project source code, models, configs, or documentation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Private Credentials, Secrets & Sensitive Files
# ------------------------------------------------------------------------------
PROJECT_CREDENTIALS_PRIVATE.txt
*credentials_private*
*credentials-private*
*CREDENTIALS_PRIVATE*
*secret*.txt
*private*.txt
secrets.txt
passwords.txt

# Environment Variable Files
.env
.env.*
*.env
*.env.*
# Allow sample / template environment files if created
!.env.example
!*.env.example

# Cryptographic Keys & Certificates
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.jks
*service-account*.json
google-services.json

# ------------------------------------------------------------------------------
# 2. Operating System Generated Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 3. IDEs, Editors & Developer Tooling
# ------------------------------------------------------------------------------
.idea/
**/.idea/
*.iws
*.iml
*.ipr
.vscode/
**/.vscode/
*.code-workspace
.gemini/
**/.gemini/
.agents/
**/.agents/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 4. Node.js & React Frontend (Vite)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm/
**/.npm/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Python, Machine Learning Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.Python
env/
**/env/
venv/
**/venv/
ENV/
**/ENV/
.venv/
**/.venv/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 6. Java, Spring Boot & Maven Builds
# ------------------------------------------------------------------------------
target/
**/target/
*.class
**/*.class
*.jar
**/*.jar
# Never ignore the Maven wrapper JAR required for running mvnw
!/**/.mvn/wrapper/maven-wrapper.jar
!/.mvn/wrapper/maven-wrapper.jar
*.war
**/*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
**/.metadata/
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.next
**/release.properties
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 7. Embedded Systems / ESP32 / PlatformIO
# ------------------------------------------------------------------------------
.pio/
**/.pio/
.pioenvs/
**/.pioenvs/
.piolibdeps/
**/.piolibdeps/
.clangd/
compile_commands.json

# ------------------------------------------------------------------------------
# 8. Logs, Dumps & Scratch Directories
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
*.tmp
*.temp
*.bak
scratch/
**/scratch/
.tempmediaStorage/
**/.tempmediaStorage/

# ------------------------------------------------------------------------------
# 9. Large Raw Datasets & Data Tables (Exceeds GitHub 100MB push limit)
# ------------------------------------------------------------------------------
01_Datasets/
**/*.csv
**/*.xlsx

# ------------------------------------------------------------------------------
# 10. Temporary Screenshots & Media Files
# ------------------------------------------------------------------------------
*.webp
/dashboard_spaced.png
/register_centered.png
/register_final_centered.png
/dashboard_extremely_good.png
