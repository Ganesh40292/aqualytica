node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm/
**/.npm/
.vite/
**/.vite/
.eslintcache
**/.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Python, Machine Learning Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
**/env/
venv/
**/venv/
ENV/
**/ENV/
.venv/
**/.venv/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
wandb/
mlruns/

# ------------------------------------------------------------------------------
# 7. Java, Spring Boot & Maven Builds
# ------------------------------------------------------------------------------
target/
**/target/
*.class
**/*.class
*.jar
**/*.jar
# Never ignore the Maven wrapper JAR required for running mvnw
!/**/.mvn/wrapper/maven-wrapper.jar
!/.mvn/wrapper/maven-wrapper.jar
*.war
**/*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
**/.metadata/
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.next
**/release.properties
hs_err_pid*
replay_pid*

# Spring Boot Local & Secret Profiles
application-local.properties
**/application-local.properties
application-secret.properties
**/application-secret.properties
application-dev.properties
**/application-dev.properties

# ------------------------------------------------------------------------------
# 8. Embedded Systems / ESP32 / PlatformIO
# ------------------------------------------------------------------------------
.pio/
**/.pio/
.pioenvs/
**/.pioenvs/
.piolibdeps/
**/.piolibdeps/
.clangd/
compile_commands.json

